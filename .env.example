# ============================================================================
# StockVerdict — environment template.  Copy to `.env` and fill in.
# NEVER commit a real .env; secrets live only in this file (gitignored) or in
# your deployment platform's secret store.
# ============================================================================

# ---- Environment -----------------------------------------------------------
# development | staging | production  (production enforces secure cookies)
STOCK_ALERT_ENV=development

# ---- Database ---------------------------------------------------------------
# SQLite is the supported, default engine. `DATABASE_URL` accepts sqlite URLs;
# non-SQLite engines fail fast at startup until PostgreSQL support is enabled
# (see DEPLOYMENT.md §3). For SQLite, prefer STOCK_ALERT_DB (absolute path).
# DATABASE_URL=sqlite:////var/lib/stockverdict/stock_verdict.db
STOCK_ALERT_DB=data/stock_verdict.db

# ---- Web server -------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
# Frontend build directory override (defaults to ./frontend/dist)
# FRONTEND_DIST=/srv/stockverdict/dist

# ---- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
# LOG_JSON=1            # structured JSON logs (recommended in production)
HTTP_TIMEOUT=20         # default socket timeout for provider libraries

# ---- Security ---------------------------------------------------------------
# REQUIRED=1 in production (HTTPS): session cookies get the Secure flag.
STOCK_ALERT_AUTH_SECURE=0

# ---- Provider credentials (optional; leave empty to disable a capability) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_API_KEY=
OPENCODE_MODEL=deepseek-v4-flash-vision-exp
OLLAMA_BASE_URL=
OLLAMA_MODEL=
NEWS_API_KEY=
ALPHA_VANTAGE_KEY=
LLM_API_KEY=
LLM_MODEL=

# ---- Social (Reddit) credentials — optional, enables the social signal -------
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=StockVerdict/0.1

# ---- Caches / provider behaviour ---------------------------------------------
STOCK_ALERT_HISTORY_TTL=1800        # chart cache TTL (s)
STOCK_ALERT_PROVIDER_COOLDOWN=120   # provider circuit-breaker cooldown (s)
STOCK_ALERT_SOCIAL_CACHE_TTL=1800
STOCK_ALERT_MOVE_PCT=0.03           # significant-move notification threshold
STOCK_ALERT_VOLUME_MULT=2.0         # volume-spike notification multiple

# ---- Worker / scheduler -------------------------------------------------------
# Background refresh cadence (seconds) — shared by worker and API throttles.
STOCK_ALERT_REFRESH_FAST=300
STOCK_ALERT_REFRESH_SLOW=1800
STOCK_ALERT_REFRESH_BATCH=25
# Set WORKER_MANAGED=1 on the API when the dedicated worker runs, so background
# news top-ups happen in exactly one process.
WORKER_MANAGED=0
